# NDAgent Configuration File
# Copy this file to /usr/local/etc/ndagent.conf and modify as needed

# Required: Enable the agent (true/false)
enabled=true

# Required: Authentication token from NetDefense server
token=your-token-here

# Required: Device UUID (unique identifier for this device)
device_uuid=your-device-uuid-here

# Server connection settings
server_host=localhost
server_port=8443

# What the connections to NetDefense (registration and the broker socket,
# the trust-key fetch, the relay) verify the server against:
#   system      - the roots built into the agent plus extra_ca_file, never
#                 the operating system's certificate store (the default)
#   custom_ca   - only the CAs of tls_ca_file, for a NetDefense server whose
#                 certificate a private CA issued (or a self-signed one)
#   spki_pinned - only the server keys tls_spki_hashes lists, each
#                 sha256/<base64 of the SHA-256 of its SubjectPublicKeyInfo>;
#                 for keys you control (a public CA's certificate usually
#                 comes with a new key at each renewal)
# The mode covers the relay too: its CA goes in tls_ca_file, or its key in
# tls_spki_hashes. Trust material a mode cannot use refuses every connection. Nothing turns
# verification off: ssl_verify, tofu_ssl_verify and pathfinder_tls_verify
# are no longer honoured, and one set to false is logged as ignored.
tls_mode=system
# tls_ca_file=/usr/local/etc/ndagent-ca.pem
# tls_spki_hashes=sha256/<server key>,sha256/<relay key>,sha256/<next key>

# Path to OPNsense config.xml file
config_xml_path=/conf/config.xml

# PID file location
pid_file=/var/run/ndagent.pid

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
log_level=INFO

# Test mode: blocks dangerous operations (SHUTDOWN, REBOOT)
test_mode=false

# Device-local defense-in-depth: reject individual USER/GROUP/ZABBIX_*
# SYNC_API snippet elements carrying a dangerous field (administrator-
# equivalent priv, membership in admins, scope=system, interactive shell,
# authorizedkeys, Zabbix remote commands, sudo_root) instead of applying
# them. Default true. The primary control is NDManager's producer-side
# org:su gate, and a USER/GROUP element that would give an account
# administrator rights without Superuser clearance is refused whatever this
# says.
reject_dangerous_snippets=true

# Pathfinder settings (for remote access via CONNECT task)
# pathfinder_host=https://pathfinder.netdefense.io
