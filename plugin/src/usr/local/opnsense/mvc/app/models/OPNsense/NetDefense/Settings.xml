<?xml version="1.0" encoding="utf-8"?>
<model>
    <mount>//OPNsense/netdefense/settings</mount>
    <description>NetDefense Agent Configuration</description>
    <version>1.0.0</version>
    <items>
        <enabled type="BooleanField">
            <Default>0</Default>
            <Required>Y</Required>
        </enabled>
        <token type="TextField">
            <mask>/^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/</mask>
            <ValidationMessage>Registration Token must be a valid UUID format</ValidationMessage>
            <Required>Y</Required>
        </token>
        <deviceId type="TextField">
            <mask>/^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/</mask>
            <ValidationMessage>Device ID must be a valid UUID format</ValidationMessage>
            <Required>Y</Required>
        </deviceId>
        <serverAddress type="TextField">
            <Default>https://hub.netdefense.io</Default>
            <Required>Y</Required>
        </serverAddress>
        <sslVerify type="BooleanField">
            <Default>1</Default>
            <Required>Y</Required>
        </sslVerify>
        <tofuSslVerify type="BooleanField">
            <!-- Governs TLS verification for the first-connect NDM JWKS
                 fetch (TOFU key pinning), independently of sslVerify.
                 Stays on even when sslVerify is disabled for lab/dev use,
                 so that toggle can't be used to plant a rogue key at the
                 one moment nothing is pinned yet. -->
            <Default>1</Default>
            <Required>Y</Required>
        </tofuSslVerify>
        <extraCaFile type="TextField">
            <!-- Optional path to a PEM file of CA certificates the agent
                 trusts for its connections to NetDefense (registration and
                 the broker socket, the trust-key fetch, the relay), besides
                 the root set built into the agent. The agent never trusts
                 the firewall's own certificate store for those connections,
                 because NetDefense can sync CAs into it; a site whose traffic
                 passes a TLS-inspection proxy puts the proxy's CA here.

                 No NetDefense sync writes this field or the file it names;
                 an administrator's session to the device can, like any
                 setting. The agent takes only a file root left: a regular
                 file root owns, with one link and no group or other write
                 permission, named without a symbolic link, outside the
                 system certificate store, in directories only root can
                 write, holding nothing but CERTIFICATE blocks. Otherwise it
                 trusts its built-in roots only. Empty (the default) adds
                 nothing. -->
            <mask>/^\/[A-Za-z0-9._+@,=\/-]{1,254}$/</mask>
            <ValidationMessage>Extra CA File must be an absolute path (letters, digits and . _ + @ , = - /)</ValidationMessage>
            <Required>N</Required>
        </extraCaFile>
        <logLevel type="OptionField">
            <Default>INFO</Default>
            <Required>Y</Required>
            <OptionValues>
                <DEBUG>DEBUG</DEBUG>
                <INFO>INFO</INFO>
                <WARNING>WARNING</WARNING>
                <ERROR>ERROR</ERROR>
            </OptionValues>
        </logLevel>
        <pathfinderHost type="TextField">
            <Default>https://pathfinder.netdefense.io</Default>
            <Required>Y</Required>
        </pathfinderHost>
        <pathfinderTlsVerify type="BooleanField">
            <Default>1</Default>
            <Required>Y</Required>
        </pathfinderTlsVerify>
        <pathfinderShell type="TextField">
            <Default>/usr/local/sbin/opnsense-shell</Default>
            <Required>Y</Required>
        </pathfinderShell>
        <remoteAccessPolicy type="OptionField">
            <!-- Device-local ceiling on NetDefense-mediated remote access
                 (CONNECT sessions). This is the device's final word: the
                 control plane may request a session at or below this
                 ceiling and never above it.

                 full     - permit whatever is requested: shell, SSH, exec
                            stream, and web UI.
                 readonly - clamp every session to read-only regardless of
                            what the control plane asks for: web UI only,
                            no shell, no SSH, no exec stream.
                 disabled - refuse remote sessions outright; no relay is
                            dialed and no stream is served.

                 Nothing reachable from the control plane can raise this
                 value. It lives here in config.xml, and the agent's
                 OPNsense REST client has no writer for the
                 netdefense/settings node (its endpoints are hardcoded
                 per-plugin: unbound/*, zabbixagent/*, wireguard/*,
                 core/service/search), so a configuration sync cannot flip
                 it. Changing it requires access to this device.

                 Default "full" — identical to behavior before the ceiling
                 existed. Unlike rejectDangerousSnippets, this default
                 matches the legacy behavior exactly, so no grandfathering
                 migration is needed in ensure_readonly.php: an absent
                 config.xml node, an absent ndagent.conf line, and an
                 explicit "full" all mean the same thing. A package upgrade
                 therefore can never silently disable remote access on an
                 existing fleet.

                 Enforced twice in the agent, deliberately: HandleConnect
                 (internal/tasks/connect.go) refuses or clamps before the
                 relay is dialed, and the pathfinder proxy's per-stream
                 chokepoint (internal/pathfinder/proxy.go) re-checks so the
                 guarantee does not depend on a single caller. -->
            <Default>full</Default>
            <Required>Y</Required>
            <OptionValues>
                <full>Full access (shell, SSH and web UI)</full>
                <readonly>Read-only web UI only (no shell)</readonly>
                <disabled>Disabled (refuse all remote sessions)</disabled>
            </OptionValues>
        </remoteAccessPolicy>
        <allowAllSnippetContent type="BooleanField">
            <!-- Operator-facing inverse of the agent's reject_dangerous_snippets
                 setting. The agent's config key and behaviour are unchanged;
                 only the presentation is inverted, once, in the ndagent.conf
                 template:

                     allowAllSnippetContent = 0  ->  reject_dangerous_snippets=true
                     allowAllSnippetContent = 1  ->  reject_dangerous_snippets=false

                 Renamed from <rejectDangerousSnippets> because the original
                 label was a double negative — unchecking a box called "Reject
                 Dangerous Snippet Content" to permit dangerous content reads
                 backwards. Default 0 (do not allow all) is therefore exactly
                 the previous secure default of reject=1; this rename changes
                 no device's behaviour.

                 Existing devices are migrated by ensure_readonly.php, which
                 writes the inverted value from any pre-existing
                 rejectDangerousSnippets node. That migration is what preserves
                 the grandfathered permissive setting on fleets that predate
                 the secure-by-default flip — without it, those devices would
                 silently tighten on upgrade. -->
            <Default>0</Default>
            <Required>Y</Required>
        </allowAllSnippetContent>
        <webadminReadonlyUser type="TextField">
            <!-- OPNsense username forged into the read-only "Open WebAdmin"
                 PHP session. Maps to the curated read-only ACL provisioned
                 by ReadOnlyUserProvisioner. -->
            <mask>/^[a-zA-Z0-9_-]{1,32}$/</mask>
            <ValidationMessage>Read-only user must be 1-32 chars (alphanumeric, underscore, hyphen)</ValidationMessage>
            <Default>netdefense-readonly</Default>
            <Required>N</Required>
        </webadminReadonlyUser>
        <apiKey type="TextField">
            <Required>N</Required>
        </apiKey>
        <apiSecret type="TextField">
            <Required>N</Required>
        </apiSecret>
        <apiConfigured type="BooleanField">
            <Default>0</Default>
            <Required>N</Required>
        </apiConfigured>
        <bootstrapToken type="TextField">
            <!-- 43-char urlsafe-base64 (secrets.token_urlsafe(32)) -->
            <mask>/^[A-Za-z0-9_-]{43}$/</mask>
            <ValidationMessage>Bootstrap token must be 43 chars urlsafe-base64</ValidationMessage>
            <Required>N</Required>
        </bootstrapToken>
    </items>
</model>