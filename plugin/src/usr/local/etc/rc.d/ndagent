#!/bin/sh
#
# NetDefense Agent
#
# PROVIDE: ndagent
# REQUIRE: NETWORKING
# KEYWORD: shutdown
#
# Add the following lines to /etc/rc.conf to enable ndagent:
# ndagent_enable (bool):   Set to "NO" by default.
#                          Set it to "YES" to enable ndagent.
# ndagent_config (str):    Configuration file path
#                          Default: /usr/local/etc/ndagent.conf
# ndagent_pidfile (str):   PID file path
#                          Default: /var/run/ndagent.pid
# ndagent_logfile (str):   Log file path
#                          Default: /var/log/ndagent.log

. /etc/rc.subr

name=ndagent
rcvar=ndagent_enable

# The Go binary only installs handlers for SIGINT/SIGTERM (see
# internal/core/shutdown.go) -- it does not catch SIGHUP. rc.subr's
# default reload_cmd sends `kill -HUP $rc_pid`, and daemon(8) is run
# without -r (no auto-restart on child exit), so an unhandled SIGHUP
# would simply kill the agent and leave it down instead of reloading
# its configuration. Override reload to do a full restart instead --
# config changes always require a fresh process anyway, and the
# OPNsense plugin's own "Apply" button already goes through this same
# restart path via ApiMutableServiceControllerBase::reconfigureAction()
# (reconfigureForceRestart() is not overridden, so it defaults to a
# forced stop/start rather than a soft reload).
extra_commands="reload"
reload_cmd="ndagent_reload"

load_rc_config $name

: ${ndagent_enable:="NO"}
: ${ndagent_config:="/usr/local/etc/ndagent.conf"}
: ${ndagent_pidfile:="/var/run/ndagent.pid"}
: ${ndagent_logfile:="/var/log/ndagent.log"}
: ${ndagent_user:="root"}
: ${ndagent_group:="wheel"}

procname="/usr/local/bin/ndagent"
command="/usr/sbin/daemon"
pidfile="${ndagent_pidfile}"

# Use FreeBSD daemon utility for backgrounding
command_args="-f -p ${ndagent_pidfile} ${procname} --config ${ndagent_config}"

# Check if service is enabled via configuration
ndagent_prestart()
{
    if [ ! -f "${ndagent_config}" ]; then
        warn "Configuration file ${ndagent_config} not found"
        return 1
    fi
    
    # Check if enabled in configuration
    if ! grep -q "^enabled=true" "${ndagent_config}"; then
        warn "NetDefense Agent is disabled in configuration"
        return 1
    fi
    
    # Validate required configuration
    if ! grep -q "^token=" "${ndagent_config}"; then
        warn "Token not configured in ${ndagent_config}"
        return 1
    fi

    ndagent_wait_gone ""
}

# daemon(8) locks the pidfile before it starts the agent and releases it only
# on its way out, after it has reaped the agent; until then a new daemon(8)
# will not start. rc.subr's stop does not wait for that. Its wait_for_pids
# returns as soon as pwait(1) sees the agent begin to exit (on FreeBSD 15 it
# asks pwait once and does not check again), while ps(1) still lists the
# exiting agent under its own name, so the start of a restart that follows at
# once can find it "already running" and leave nothing running. Wait for the
# pid to be gone, then for the pidfile to be released. Only a lock still held
# fails the wait: a lockf that cannot run says nothing about the lock, and
# daemon(8) refuses a second instance by itself, so the agent still starts.
ndagent_wait_gone()
{
    local _pid _n _rc
    _pid=$1
    _n=0
    while [ -n "${_pid}" ] && kill -0 "${_pid}" 2>/dev/null; do
        [ "${_n}" -ge 300 ] && break
        sleep 0.1
        _n=$((_n + 1))
    done

    lockf -k -n -s -t 30 "${pidfile}" true
    _rc=$?
    case ${_rc} in
    0|69)   # released, or no pidfile left (EX_UNAVAILABLE)
        return 0
        ;;
    75)     # EX_TEMPFAIL: still locked after 30 s
        warn "the previous ${name} instance still holds ${pidfile}"
        return 1
        ;;
    esac
    warn "could not wait for ${pidfile} to be released (lockf exited ${_rc}); going on"
    return 0
}

ndagent_poststop()
{
    ndagent_wait_gone "${rc_pid}"
}

ndagent_status()
{
    if [ -f "${pidfile}" ]; then
        pid=$(cat "${pidfile}")
        if kill -0 "${pid}" 2>/dev/null; then
            echo "NetDefense Agent is running (pid: ${pid})"
            return 0
        else
            echo "NetDefense Agent is not running (stale pid file)"
            return 1
        fi
    else
        echo "NetDefense Agent is not running"
        return 1
    fi
}

ndagent_reload()
{
    run_rc_command "restart"
}

start_precmd=ndagent_prestart
stop_postcmd=ndagent_poststop
status_cmd=ndagent_status

run_rc_command "$1"
